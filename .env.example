# Variáveis de ambiente do n8n. Copie para .env (que nunca vai pro git).
# Tokens NÃO entram aqui: Notion e WhatsApp ficam nas credenciais do n8n.

# Notion: id do database "Atendimentos" (o hash da URL)
NOTION_DB_ATENDIMENTOS=

# WhatsApp Cloud API
WA_API_VERSION=v23.0
WA_PHONE_NUMBER_ID=
# WhatsApp do tatuador, só dígitos, com 55 e DDD (ex.: 5527999999999)
WA_RUSSO=
